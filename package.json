{
  "name": "@iolo/redraw",
  "version": "0.0.1",
  "author": "Dongsu Jang",
  "description": "MSPaint-like drawing component for React",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iolo/redraw.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/redraw.cjs",
  "module": "./dist/redraw.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/redraw.js",
      "require": "./dist/redraw.cjs"
    },
    "./styles.css": "./dist/redraw.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:build": "vite build --config vite.config.demo.ts",
    "demo:deploy": "npm run demo:build && npx gh-pages -d dist/app --nojekyll"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
